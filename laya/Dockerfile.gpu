# Servicio GPU opcional de Laya. Requiere NVIDIA Container Toolkit.
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
RUN pip install --no-cache-dir "laya[fast]" "fastapi" "uvicorn[standard]" huggingface_hub

COPY laya/service/app.py /srv/app.py

ENV LAYA_MODEL_ID=convaiinnovations/laya \
    LAYA_SUBFOLDER=typed-decisions \
    LAYA_DEVICE=cuda \
    LAYA_FAST=1 \
    HF_HOME=/cache/huggingface

EXPOSE 8001
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8001"]

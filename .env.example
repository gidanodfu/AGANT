# AGANT - variables de entorno. Copiar a .env y ajustar.
# Nunca commitear .env con secretos.

AGANT_ENV=development
AGANT_LOG_LEVEL=INFO

# Rutas (relativas a la raiz del repo si no son absolutas)
AGANT_DATA_DIR=./data
AGANT_RESULTS_DIR=./results

# Decision
AGANT_THRESHOLD_SUSPICIOUS=0.2
AGANT_THRESHOLD_FRAUD=0.5
# Modelo servido: gbm (por defecto, supera al RF) o rf.
AGANT_MODEL_KIND=gbm

# Procesamiento (memoria acotada)
AGANT_CHUNK_ROWS=250000
# Tamaño de lote de inferencia ML (32 o 64) y tamaño de bloque de proceso.
AGANT_BATCH_SIZE=32
AGANT_BLOCK_SIZE=100000
# Publicación de eventos en flujos: sampled (FRAUD/SUSPICIOUS/Laya + 1 de cada K) o all.
AGANT_PUBLISH_MODE=sampled
AGANT_PUBLISH_SAMPLE_EVERY=100
AGANT_REQUEST_TIMEOUT_MS=2000

# Grafo online (LRU)
AGANT_GRAPH_MAX_ACCOUNTS=2000000
AGANT_GRAPH_MAX_EDGES=2000000

# Reglas
AGANT_RULE_HIGH_AMOUNT=200000
AGANT_RULE_DEST_FAN_IN=10

# EventBus
AGANT_MAX_EVENTS=1000
# Eventos retenidos para recuperación tras reconexión del WebSocket (last_sequence).
AGANT_EVENT_HISTORY=1000
AGANT_WS_REPLAY=0

# Modo de decisión: hybrid (Laya solo SOSPECHOSAS) | laya_all (Laya decide todas)
AGANT_DECISION_MODE=hybrid

# Laya
AGANT_LAYA_ENABLED=1
AGANT_LAYA_MODE=pretrained
AGANT_LAYA_DEVICE=cuda
AGANT_LAYA_MODEL_ID=convaiinnovations/laya
AGANT_LAYA_SUBFOLDER=typed-decisions
AGANT_LAYA_CUSTOM_SUBFOLDER=
# Subcarpetas seleccionables en el modo Custom (separadas por coma).
AGANT_LAYA_SUBFOLDERS=typed-decisions,multilingual
AGANT_LAYA_WARMUP=1
AGANT_LAYA_URL=

# Red / seguridad
AGANT_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AGANT_ALLOWED_WS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Token admin. Si se define, protege /replay/*, /flow/*, /transactions/import y /laya/{load,test}
# (exigen cabecera X-Admin-Token). Vacío = panel abierto (solo desarrollo).
AGANT_ADMIN_TOKEN=
# /health en modo estricto: cualquier componente degradado (modelo, dataset, GPU) lo marca como "degraded".
AGANT_HEALTH_STRICT=0
AGANT_API_URL=http://localhost:8000
AGANT_WS_URL=ws://localhost:8000
